{
  "schema_version": "3.0.0",
  "note": "All models use float32 I/O — compatible with tflite_flutter",
  "models": {
    "tier_crossing": {
      "file": "volty_tier_model.tflite",
      "scaler_file": "volty_tier_scaler.json",
      "input_shape": [
        1,
        17
      ],
      "output_shape": [
        1,
        1
      ],
      "output_type": "sigmoid",
      "threshold": 0.5,
      "feature_columns": [
        "day_of_month",
        "days_remaining",
        "month",
        "current_month_kwh",
        "projected_month_end_kwh",
        "daily_kwh_rate",
        "current_tier_idx",
        "tier_max_kwh",
        "distance_to_next_tier",
        "num_devices",
        "avg_session_duration_hours",
        "total_sessions_this_month",
        "ac_usage_hours",
        "sim_avg_hourly_kw",
        "current_bill_egp",
        "projected_bill_egp",
        "bill_increase_if_cross_egp"
      ],
      "accuracy_pct": 99.02
    },
    "anomaly": {
      "file": "volty_anomaly_model.tflite",
      "scaler_file": "volty_anomaly_scaler.json",
      "input_shape": [
        1,
        7
      ],
      "output_shape": [
        1,
        1
      ],
      "output_type": "sigmoid",
      "threshold": 0.45,
      "feature_columns": [
        "daily_wh",
        "month",
        "day_of_week",
        "z_score",
        "ratio_vs_mean",
        "avg_start_hour",
        "is_night"
      ],
      "accuracy_pct": 100.0
    },
    "forecast": {
      "file": "volty_forecast_model.tflite",
      "scaler_file": "volty_forecast_scaler.json",
      "input_shape": [
        1,
        7
      ],
      "output_shape": [
        1,
        1
      ],
      "output_type": "regression_egp",
      "feature_columns": [
        "daily_kwh_rate",
        "month",
        "num_devices",
        "ac_usage_ratio",
        "day_of_month",
        "seasonal_factor",
        "current_bill_egp"
      ],
      "mae_egp": 17.03
    }
  },
